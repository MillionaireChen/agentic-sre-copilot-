// Grafana Alloy: tail service JSON log files and push to Loki.
// (Docker-free deployment: services write JSON logs to run/logs/*.log)

local.file_match "service_logs" {
  path_targets = [
    {__path__ = env("SRE_REPO") + "/run/logs/*.log"},
  ]
}

loki.source.file "services" {
  targets    = local.file_match.service_logs.targets
  forward_to = [loki.process.parse.receiver]
}

loki.process "parse" {
  stage.json {
    expressions = {level = "level", service = "service", ts = "ts"}
  }
  stage.labels {
    values = {level = "", service = ""}
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}
